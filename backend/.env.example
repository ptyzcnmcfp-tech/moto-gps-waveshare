# Copy to .env (ignored by Git). Load explicitly with node --env-file=.env.
# Modes:
#   disabled - safe initial deployment default (rejects live calls cleanly)
#   fixture  - offline deterministic demo/simulation routes & POIs (no API key needed)
#   amap     - Mainland China live navigation via AMap Web Service v5 (GCJ-02)
#   google   - Overseas / global live navigation via Google Routes v2 & Places New (WGS84)
#   auto     - Automatically dispatches Mainland China to AMap and overseas to Google
MOTO_PROVIDER=disabled

# Mainland China (AMap)
AMAP_WEB_SERVICE_KEY=
# Optional: set to true only if your AMap Enterprise account has /v5/direction/motor enabled
AMAP_ENABLE_MOTORCYCLE_API=false
AMAP_DEFAULT_PLATE=
AMAP_MOTORCYCLE_TYPE=

# Overseas / Global (Google Maps Platform)
GOOGLE_MAPS_API_KEY=
GOOGLE_TRAVEL_MODE=TWO_WHEELER
GOOGLE_TRAFFIC_REFRESH_ENABLED=false

PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:4173,http://localhost:4173,http://localhost:5173
