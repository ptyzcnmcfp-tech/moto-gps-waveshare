# Copy to .dev.vars for LOCAL testing. Never commit a real key.
# fixture returns deterministic routes & sample POIs without contacting upstream APIs.
MOTO_PROVIDER=fixture
MOTO_MAP_PMTILES_URL=disabled
# For live LOCAL testing, set MOTO_PROVIDER=amap, google, or auto and configure keys:
# AMAP_WEB_SERVICE_KEY=
# GOOGLE_MAPS_API_KEY=
